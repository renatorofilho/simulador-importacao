# Simulador de Importação Pro - Configuração de Produção

# Ambiente
NODE_ENV=production

# Banco de Dados (MySQL/TiDB)
# Formato: mysql://usuario:senha@host:porta/banco_de_dados
# Exemplo: mysql://admin:senha123@db.example.com:3306/comex_db
DATABASE_URL="mysql://usuario:senha@host:porta/banco_de_dados"

# OAuth - URL do servidor de autenticação
# Se estiver usando Manus OAuth, use a URL de produção
OAUTH_SERVER_URL="https://seu-oauth-server.com"

# Porta do servidor (padrão: 3000)
PORT=3000

# URL base da aplicação (para links e redirecionamentos)
APP_URL="https://seu-dominio.com"

# Chaves de API (se necessário para integrações futuras)
# SISCOMEX_API_KEY="sua-chave-aqui"
# RECEITAFEDERAL_API_KEY="sua-chave-aqui"

# Configurações de segurança
# CORS_ORIGIN="https://seu-dominio.com"
# SESSION_SECRET="sua-chave-secreta-aqui"

# Configurações de logging
LOG_LEVEL="info"

# Configurações de cache
CACHE_TTL=86400  # 24 horas em segundos
